<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title if title else "Matt Hovis" }}</title>
  <meta name="description" content="{{ description if description else 'Matt Hovis, developer and business analyst in Atlanta. Builds production software with AI coding agents.' }}" />
  <meta property="og:title" content="{{ title if title else 'Matt Hovis' }}" />
  <meta property="og:description" content="Developer and business analyst in Atlanta. Builds production software with AI coding agents." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://matthovis.io/" />
  <meta name="theme-color" content="#f7f6f2" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#121211" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Newsreader:opsz,wght@6..72,400;6..72,500;6..72,600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css?v=3" />
  <script>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  <header class="nav">
    <div class="wrap nav__inner">
      <a href="/" class="nav__brand" aria-label="Matt Hovis, home">Matt Hovis</a>
      <nav aria-label="Primary">
        <ul class="nav__links" id="navLinks">
          <li><a href="/#work">Work</a></li>
          <li><a href="/#code">Code</a></li>
          <li><a href="/#projects">Projects</a></li>
          <li><a href="/#career">Career</a></li>
          <li><a href="/#contact">Contact</a></li>
        </ul>
      </nav>
      <div class="nav__actions">
        <button class="icon-btn" id="themeToggle" type="button" aria-label="Switch color theme">
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
        <button class="icon-btn nav__toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap footer__inner">
      <p>&copy; 2026 Matt Hovis</p>
    </div>
  </footer>

  <script src="/ui.js?v=3" defer></script>
  {% if charts %}<script src="/charts.js?v=3" defer></script>{% endif %}
</body>
</html>
