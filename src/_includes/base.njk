<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{ title if title else "Matt Hovis" }}</title>
  <meta name="description" content="{{ description if description else 'Matt Hovis, developer and business analyst in Atlanta. Builds production software with AI coding agents.' }}" />
  <meta property="og:title" content="{{ title if title else 'Matt Hovis' }}" />
  <meta property="og:description" content="Developer and business analyst in Atlanta. Builds production software with AI coding agents." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://matthovis.io/" />
  <meta name="theme-color" content="#eef0f3" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0b0f16" media="(prefers-color-scheme: dark)" />
  <link rel="icon" href="/favicon.svg?v=4" type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css?v=4" />
  <script>
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    })();
  </script>
</head>
<body>
  <a href="#main" class="skip-link">Skip to main content</a>

  <header class="nav">
    <div class="wrap nav__inner">
      <a href="/" class="brand" aria-label="Matt Hovis, home">
        <span class="brand__badge" aria-hidden="true">MH</span>
        <span class="brand__name">Matt Hovis</span>
      </a>
      <nav aria-label="Primary">
        <ul class="nav__links" id="navLinks">
          <li><a href="/#work"><span aria-hidden="true">02</span>Work</a></li>
          <li><a href="/#code"><span aria-hidden="true">03</span>Code</a></li>
          <li><a href="/#projects"><span aria-hidden="true">04</span>Projects</a></li>
          <li><a href="/#career"><span aria-hidden="true">05</span>Career</a></li>
          <li><a href="/#contact"><span aria-hidden="true">07</span>Contact</a></li>
        </ul>
      </nav>
      <div class="nav__actions">
        <button class="icon-btn" id="themeToggle" type="button" aria-label="Switch color theme">
          <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 2.5v2.5M12 19v2.5M2.5 12H5M19 12h2.5M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
        </button>
        <button class="icon-btn nav__toggle" id="navToggle" type="button" aria-expanded="false" aria-controls="navLinks" aria-label="Open menu">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="square"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer">
    <div class="wrap">
      <dl class="titleblock">
        <div><dt>Drawn by</dt><dd>M. Hovis</dd></div>
        <div><dt>Title</dt><dd>matthovis.io</dd></div>
        <div><dt>Rev</dt><dd>2026.11</dd></div>
        <div><dt>Sheet</dt><dd>1 of 1</dd></div>
        <div><dt>&copy;</dt><dd>2026 Matt Hovis</dd></div>
      </dl>
    </div>
  </footer>

  <script src="/ui.js?v=4" defer></script>
  {% if charts %}<script src="/charts.js?v=4" defer></script>{% endif %}
</body>
</html>
